# rust
target/
**/*.rs.bk

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# benchmark corpora are fetched, never vendored; held-out set lives in ~/.tee-audit-bench/
bench/corpus/
bench/.cache/
*.eif

# audit output
out/
*.report.json
*.report.md

# local
.env
# ...but fixture .env files are the test data: two BT-T09B findings live in
# eigencompute-vulnerable/.env, and ignoring them meant CI ran a weaker fixture than a
# developer did, with the gate passing either way.
!bench/fixtures/**/.env
.DS_Store
.idea/
.vscode/

# fixture EIFs are generated by bench/fixtures/build.py, not committed
bench/fixtures/*.eif
