{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEnclaveDecryptNoAttestation",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::123456789012:role/enclave-parent"},
      "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "*"
    },
    {
      "Sid": "AllowEnclavePcr0Only",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::123456789012:role/enclave-parent"},
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "kms:RecipientAttestation:PCR0": "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"
        }
      }
    }
  ]
}
