{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEnclaveDecryptAttested",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::123456789012:role/enclave-parent"},
      "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "*",
      "Condition": {
        "StringEqualsIgnoreCase": {
          "kms:RecipientAttestation:PCR1": "b1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90",
          "kms:RecipientAttestation:PCR2": "c1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90",
          "kms:RecipientAttestation:PCR8": "d1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"
        }
      }
    },
    {
      "Sid": "AllowDescribeUnconditional",
      "Effect": "Allow",
      "Principal": {"AWS": "arn:aws:iam::123456789012:role/ops"},
      "Action": ["kms:DescribeKey", "kms:ListAliases"],
      "Resource": "*"
    }
  ]
}
