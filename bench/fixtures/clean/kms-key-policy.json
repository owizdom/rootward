          "kms:RecipientAttestation:PCR2": "21b9efbc184807662e966d34f390821309eeac6802309798826296bf3e8bec7c10edb30948c90ba67310f7b964fc500a"
        }
      }
    },
    {
      "Sid": "AllowDescribeUnconditional",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:role/ops"
      },
      "Action": [
        "kms:DescribeKey",
